# Obbligatoria: nessun default, il server non si avvia senza.
OPENROUTER_API_KEY=

# Facoltative (i valori qui sotto sono i default applicati se omesse).
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Provati in ordine se il modello preferito è irraggiungibile o rate-limited
# (scelti per costo contenuto; lista vuota = nessun fallback). OpenRouter
# accetta al massimo 3 modelli in tutto (primario + 2 fallback).
OPENROUTER_FALLBACK_MODELS=anthropic/claude-haiku-5.5,openai/gpt-4o-mini
# Tetto di sicurezza in $ per milione di token, qualunque sia il modello/
# provider scelto da OpenRouter: impedisce un routing verso qualcosa di
# costoso anche per errore di configurazione.
OPENROUTER_MAX_PRICE_PROMPT=0.50
OPENROUTER_MAX_PRICE_COMPLETION=2.00
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PORT=8080
MAX_TOKENS=700
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=80
REQUEST_TIMEOUT_SECONDS=60
TRUST_PROXY_HEADERS=true

# Per lo sviluppo locale, carica queste variabili con:
#   export $(grep -v '^#' .env | xargs)
# (dopo aver copiato questo file in .env e inserito la tua chiave).
